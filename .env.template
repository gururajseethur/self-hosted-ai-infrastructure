# ============================================
# Cloudflare Configuration
# ============================================
# Get TUNNEL_TOKEN from: https://dash.cloudflare.com/
# Format: eyJhIjog...
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# ============================================
# Domain Configuration
# ============================================
# Your registered domain in Cloudflare
DOMAIN=gururajseethur.in

# ============================================
# Grafana Configuration
# ============================================
# Change these immediately in production!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate_strong_password_here

# ============================================
# Traefik Configuration
# ============================================
# For Let's Encrypt SSL certificates
TRAEFIK_CERTIFICATESEMAIL=your-email@gururajseethur.in

# Traefik Basic Auth (used for Prometheus/Ollama HTTP auth)
# CHANGE these to a strong username/password before deploy
TRAEFIK_BASIC_AUTH_USER=admin
TRAEFIK_BASIC_AUTH_PASSWORD=change_me_now

# ============================================
# Prometheus Configuration
# ============================================
# Retention period for metrics (default: 7 days)
PROMETHEUS_RETENTION=7d
